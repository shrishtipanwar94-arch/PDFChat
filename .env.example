# PostgreSQL + pgvector (docker compose maps it to host port 5434)
DATABASE_URL=postgresql://rag:rag@localhost:5434/rag

# At least one provider key, or OLLAMA_URL for fully local runs
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=
# OLLAMA_MODEL=qwen2.5:3b

# Optional model overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# GEMINI_MODEL=gemini-2.5-flash

# Failover order; providers without a key are skipped
PROVIDER_ORDER=groq,openrouter,gemini,ollama

MAX_UPLOAD_MB=10
SESSION_TTL_HOURS=24
# Requests per minute per session
RATE_LIMIT_PER_MINUTE=30

SENTRY_DSN=
